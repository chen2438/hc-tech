---
import { site } from '../data/site';
interface Props { full?: boolean }
const { full = false } = Astro.props;
---

<section class="section shell" aria-labelledby="work-title">
  {!full && <div class="section-head"><p class="eyebrow">03 / Work</p><h2 class="section-title" id="work-title">Selected Work</h2></div>}
  <div class="work-list">
    {site.projects.map((project) => (
      <article id={full ? project.slug : undefined}>
        <header>
          <p class="meta">{project.number} / Project</p>
          <h2 class:list={{ 'project-title': true, 'home-title': !full }}>{project.title}</h2>
        </header>
        <div class="summary">
          <p class="intro">{project.introduction}</p>
          <ul class="tag-list" aria-label="Technology used">
            {project.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
          {!full && <a class="arrow-link" href={`/work#${project.slug}`}>View project <span aria-hidden="true">→</span></a>}
        </div>
        {full && (
          <dl>
            <div><dt>Problem</dt><dd>{project.problem}</dd></div>
            <div><dt>Approach</dt><dd>{project.approach}</dd></div>
            <div><dt>Solution</dt><dd>{project.solution}</dd></div>
            <div><dt>Outcome</dt><dd>{project.outcome}</dd></div>
          </dl>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .work-list { border-top: 1px solid var(--line); }
  article { scroll-margin-top: 2rem; display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 7vw, 9rem); padding-block: clamp(3rem, 7vw, 7.5rem); border-bottom: 1px solid var(--line); }
  header .meta { margin: 0 0 1.5rem; }
  .project-title { margin: 0; max-width: 10ch; font-family: Iowan Old Style, serif; font-size: clamp(3.6rem, 7.5vw, 8rem); line-height: .9; letter-spacing: -.055em; font-weight: 400; }
  .home-title { font-size: clamp(3rem, 5.8vw, 6.5rem); }
  .summary { align-self: end; }
  .intro { max-width: 48ch; margin: 0 0 2rem; color: var(--muted); font-size: clamp(1.05rem, 1.45vw, 1.3rem); }
  .tag-list { margin-bottom: 2.5rem; }
  dl { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin: 2rem 0 0; background: var(--line); border: 1px solid var(--line); }
  dl div { padding: clamp(1.25rem, 2.5vw, 2.5rem); background: var(--paper); }
  dt { margin-bottom: 1.2rem; font-family: "SFMono-Regular", monospace; font-size: .7rem; letter-spacing: .09em; text-transform: uppercase; }
  dd { margin: 0; color: var(--muted); }
  @media (max-width: 800px) { article { grid-template-columns: 1fr; } dl { grid-template-columns: 1fr; } .summary { align-self: auto; } }
</style>
