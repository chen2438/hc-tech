---
import { site } from '../data/site';
---

<footer class="site-footer shell">
  <div class="identity">
    <p class="name">{site.name}</p>
    <p>{site.title}</p>
    <p>Trading as {site.businessName}</p>
  </div>
  <div class="footer-right">
    <nav aria-label="Contact">
      <a href={`mailto:${site.email}`}>Email ↗</a>
    </nav>
    <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-block: 3.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; }
  p { margin: .18rem 0; }
  .name { margin-bottom: .7rem; color: var(--ink); font-size: 1rem; font-weight: 600; }
  .footer-right { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 3rem; text-align: right; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  nav a:hover { color: var(--ink); }
  @media (max-width: 640px) { .site-footer { grid-template-columns: 1fr; } .footer-right { align-items: flex-start; text-align: left; } }
</style>
