---
import { site } from '../data/site';
---

<section class="section shell" aria-labelledby="services-title">
  <div class="section-head">
    <p class="eyebrow">01 / Services</p>
    <h2 class="section-title" id="services-title">What I do</h2>
  </div>
  <div class="service-list">
    {site.services.map((service) => (
      <article>
        <p class="meta">{service.number}</p>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
        <span aria-hidden="true">↘</span>
      </article>
    ))}
  </div>
</section>

<style>
  .service-list { border-top: 1px solid var(--line); }
  article { display: grid; grid-template-columns: minmax(5rem, .55fr) 1.5fr 1.4fr auto; gap: clamp(1.5rem, 4vw, 5rem); align-items: start; padding-block: clamp(1.8rem, 3.5vw, 3rem); border-bottom: 1px solid var(--line); }
  h3 { margin: 0; font-family: Iowan Old Style, serif; font-size: clamp(2rem, 3.4vw, 4rem); font-weight: 400; line-height: 1; letter-spacing: -.035em; }
  article > p:not(.meta) { max-width: 50ch; margin: .25rem 0 0; color: var(--muted); }
  article > span { font-size: 1.4rem; transition: transform .25s var(--ease); }
  article:hover > span { transform: translate(.2rem, .2rem); }
  @media (max-width: 760px) { article { grid-template-columns: 3rem 1fr auto; } article > p:not(.meta) { grid-column: 2 / -1; } }
</style>
