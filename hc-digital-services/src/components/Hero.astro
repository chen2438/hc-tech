---
import { site } from '../data/site';
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-top">
    <p class="identity">{site.name} <span>·</span> {site.title}</p>
    <p class="meta">UK / Software / AI / Automation</p>
  </div>
  <h1 id="hero-title">
    <span>Technology should</span>
    <span>solve real problems.</span>
    <span class="shift">Not create more</span>
    <span class="shift">of them.</span>
  </h1>
  <div class="hero-foot">
    <p>I design and build software, AI systems and automation that help businesses work more effectively.</p>
    <a class="arrow-link" href="/contact">Discuss a project <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .hero { min-height: calc(100svh - 5.5rem); padding-block: clamp(2.5rem, 5vw, 5.5rem); display: flex; flex-direction: column; justify-content: space-between; border-bottom: 1px solid var(--line); overflow: clip; }
  .hero-top { display: flex; justify-content: space-between; align-items: baseline; gap: 2rem; }
  .identity { margin: 0; font-size: .8rem; }
  .identity span { margin-inline: .35rem; color: var(--muted); }
  h1 { margin: clamp(3.5rem, 7vh, 7rem) 0; font-family: Iowan Old Style, Baskerville, "Times New Roman", serif; font-size: clamp(4rem, 9.15vw, 10.5rem); font-weight: 400; line-height: .82; letter-spacing: -.07em; }
  h1 span { display: block; white-space: nowrap; }
  .shift { padding-left: 14vw; }
  .hero-foot { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 3rem; }
  .hero-foot p { max-width: 47ch; margin: 0; color: var(--muted); font-size: clamp(1rem, 1.35vw, 1.25rem); }
  .arrow-link { justify-self: end; }
  @media (max-width: 760px) {
    .hero { min-height: auto; padding-block: 2rem 3.5rem; }
    .hero-top { display: grid; gap: .55rem; }
    h1 { margin: 5.5rem 0 4rem; font-size: clamp(3.75rem, 18.5vw, 7rem); line-height: .87; }
    h1 span { white-space: normal; }
    .shift { padding-left: 0; }
    .hero-foot { grid-template-columns: 1fr; gap: 2.5rem; }
    .arrow-link { justify-self: start; }
  }
</style>
