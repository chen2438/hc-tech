---
interface Props { eyebrow: string; title: string; description: string }
const { eyebrow, title, description } = Astro.props;
---
<header class="page-header shell">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="page-title">{title}</h1>
  <p class="lede">{description}</p>
</header>
<style>
  .page-header { min-height: min(48rem, calc(100svh - 5.5rem)); display: grid; grid-template-columns: 1fr 3fr; grid-template-rows: auto 1fr auto; gap: 2rem clamp(2rem, 6vw, 8rem); padding-block: clamp(3rem, 7vw, 7rem); border-bottom: 1px solid var(--line); }
  .page-title { grid-column: 2; align-self: center; }
  .lede { grid-column: 2; margin: 0; align-self: end; }
  @media (max-width: 720px) { .page-header { min-height: 38rem; grid-template-columns: 1fr; grid-template-rows: auto 1fr auto; } .page-title, .lede { grid-column: 1; } }
</style>
